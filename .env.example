PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=iwmsadvisors
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=1h

ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRES=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES=10d

CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

GOOGLE_MAPS_API_KEY=your_google_maps_key

EMAIL_EXPIRES=900000  
EMAIL_FROM=webmaster@iwmsadvisors.com
EMAIL_FROM_NAME="IWMS Advisors"
EMAIL_TO=""
ADMIN_EMAIL=webmaster@iwmsadvisors.com

# Microsoft Graph API (OAuth2)
MS_TENANT_ID=your_ms_tenant_id
MS_CLIENT_ID=your_ms_client_id
MS_CLIENT_SECRET=your_ms_client_secret
MS_GRAPH_SENDER_EMAIL=webmaster@iwmsadvisors.com

# SMTP Fallback
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_SECURE=false

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

FRONTEND_URL=https://test.iwmsadvisors.com
PUBLIC_CAREERS_BASE_URL=https://test.iwmsadvisors.com/careers
